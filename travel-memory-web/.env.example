# AMap Web JS API Key. Apply for this separately from AMAP_WEB_SERVICE_KEY.
VITE_AMAP_JS_API_KEY=

# For local development or temporary testing only. Prefer VITE_AMAP_SERVICE_HOST in production.
VITE_AMAP_SECURITY_JS_CODE=

# Production AMap security proxy path, for example /_AMapService.
VITE_AMAP_SERVICE_HOST=
