# Temporary test deployment configuration.
#
# Copy this file to .env after cloning the repository, then start with Docker
# Compose. These values are intentionally for local/ECS test deployment only;
# replace every password and AMap credential before a public production launch.
# .env stays ignored so later ECS-specific changes are never overwritten by git.

TZ=Asia/Shanghai
HTTP_PORT=80

# Set true only after HTTPS is enabled.
APP_SESSION_COOKIE_SECURE=false

# A fresh database uses the invitation below to create the first administrator.
# Turn registration off and clear the invite code after the first account exists.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_REGISTRATION_ENABLED=true
APP_REGISTRATION_INVITE_CODE=travel-memory-test-invite-2026

MYSQL_DATABASE=travel_memory
MYSQL_USER=travel_user
MYSQL_PASSWORD=Travel@123456
MYSQL_ROOT_PASSWORD=TravelMemoryRoot@123456

# Used by scripts/run-local-backend.ps1. Docker Compose overrides these with
# the mysql service address and MYSQL_* values above.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travel_memory?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=travel_user
SPRING_DATASOURCE_PASSWORD=Travel@123456

# Host path or relative path for uploaded images.
UPLOADS_DIR=./uploads
APP_UPLOAD_DIR=../uploads

# Orphan upload cleanup remains disabled and dry-run by default.
APP_UPLOAD_CLEANUP_ENABLED=false
APP_UPLOAD_CLEANUP_DRY_RUN=true
APP_UPLOAD_CLEANUP_RETENTION_HOURS=24
APP_UPLOAD_CLEANUP_CRON="0 30 3 * * ?"

# Temporary AMap Web Service key for backend POI search and reverse geocoding.
AMAP_WEB_SERVICE_KEY=2dbe3c55dbe1f28f9d6b536fcbae3d60
AMAP_REVERSE_GEOCODE_ENABLED=true

# Temporary AMap Web JS values injected into the frontend Docker image at build time.
# AMAP_WEB_SERVICE_KEY must never be copied into a VITE_ variable.
VITE_AMAP_JS_API_KEY=18dc468958893206b385e5177e747de0
VITE_AMAP_SECURITY_JS_CODE=d18a507d2bfe61a85a68f7d5672b1167
VITE_AMAP_SERVICE_HOST=
