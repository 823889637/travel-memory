# Copy this file to .env on the ECS server and fill real values.
# Do not commit .env.

TZ=Asia/Shanghai
HTTP_PORT=80
# Set true only after HTTPS is enabled in production.
APP_SESSION_COOKIE_SECURE=false
# Keep registration disabled in production unless you intentionally invite a new user.
APP_REGISTRATION_ENABLED=false
APP_REGISTRATION_INVITE_CODE=

MYSQL_DATABASE=travel_memory
MYSQL_USER=travel_user
MYSQL_PASSWORD=replace_with_a_strong_unique_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password

# Host path or relative path for uploaded images.
UPLOADS_DIR=./uploads

# Orphan upload cleanup stays disabled. When testing it on ECS, enable it with
# dry-run=true first and inspect logs before considering real deletion.
APP_UPLOAD_CLEANUP_ENABLED=false
APP_UPLOAD_CLEANUP_DRY_RUN=true
APP_UPLOAD_CLEANUP_RETENTION_HOURS=24
APP_UPLOAD_CLEANUP_CRON="0 30 3 * * ?"

# Amap WebService for reverse geocoding and POI location search.
# Leave empty to disable server-side location suggestions and search.
# The flag only controls reverse-geocoding suggestions.
AMAP_WEB_SERVICE_KEY=
AMAP_REVERSE_GEOCODE_ENABLED=false

# These values are injected into the frontend at Docker build time.
# Use a separately issued AMap JS API key. Do not reuse AMAP_WEB_SERVICE_KEY.
VITE_AMAP_JS_API_KEY=
VITE_AMAP_SECURITY_JS_CODE=
VITE_AMAP_SERVICE_HOST=
